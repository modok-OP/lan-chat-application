# LAN Chat Application Environment Configuration

# Server Settings
APP_NAME="LAN Chat Application"
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=true
SECRET_KEY=change-this-in-production-secure-random-secret-key

# Database (defaults to data/lan_chat.db relative to project root)
# DATABASE_URL=sqlite+aiosqlite:///../data/lan_chat.db

# Storage Limits (bytes: 25MB = 26214400)
MAX_UPLOAD_SIZE_BYTES=26214400

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
